{
  "name": "@yungkei/model-compass",
  "version": "1.1.4",
  "description": "Intelligent LLM routing system with multi-provider support, automatic failover, and runtime data source switching",
  "author": "yungkei <53671318+yungkei@users.noreply.github.com>",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "bin": {
    "mc": "./dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yungkei/model-compass.git"
  },
  "files": [
    "dist/",
    "package.json",
    "LICENSE",
    "README.md",
    "README-zh.md"
  ],
  "keywords": [
    "llm",
    "router",
    "proxy",
    "openai",
    "claude",
    "ai",
    "multi-provider",
    "failover"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "ts-node src/server/index.ts",
    "cli": "ts-node src/cli/index.ts",
    "link": "npm run build && npm link",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "figlet": "^1.11.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/figlet": "^1.7.0",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
